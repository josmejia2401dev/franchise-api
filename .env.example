SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# Option A (local, simplest): full URI in the template, credentials left empty.
MONGODB_URI_TEMPLATE=mongodb+srv://<user>:<password>@<cluster-host>/franchise?retryWrites=true&w=majority&appName=Cluster0
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Option B (template with placeholders): keep {username}/{password} in the template
# and provide them separately.
# MONGODB_URI_TEMPLATE=mongodb+srv://{username}:{password}@<cluster-host>/franchise?retryWrites=true&w=majority&appName=Cluster0
# MONGODB_USERNAME=your-user
# MONGODB_PASSWORD=your-pass
